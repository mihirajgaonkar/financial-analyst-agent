APP_NAME="Financial Research Agent"
ENVIRONMENT=development

SEC_USER_AGENT="Financial Research Agent contact@example.com"
FRED_API_KEY=
MARKET_DATA_PROVIDER=alpha_vantage
ALPHA_VANTAGE_API_KEY=
DATABASE_URL=postgresql+psycopg://financial_research:financial_research@localhost:5432/financial_research
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=
RESEARCH_TIMEOUT_SECONDS=60
DEBUG_REPORTS_ENABLED=true
DEBUG_REPORTS_DIR=debug_reports
FILE_STORAGE_ENABLED=true
FILE_STORAGE_DIR=storage/runs
PROVIDER_CACHE_ENABLED=true
PROVIDER_CACHE_DIR=storage/provider_cache
SEC_CACHE_TTL_SECONDS=5184000
FRED_CACHE_TTL_SECONDS=21600
ALPHA_VANTAGE_CACHE_TTL_SECONDS=900
SEC_COMPANY_FACTS_HISTORY_LIMIT=5
DATABASE_PERSISTENCE_ENABLED=false
DATABASE_STORE_RAW_PROVIDER_PAYLOADS=false

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
